{
  "name": "@mp-consulting/homebridge-ui-kit",
  "version": "1.2.0",
  "description": "Brand design system for @mp-consulting Homebridge plugins",
  "keywords": [
    "homebridge",
    "homebridge-ui",
    "bootstrap",
    "design-system"
  ],
  "homepage": "https://github.com/mp-consulting/homebridge-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-ui-kit/issues"
  },
  "author": "MP Consulting",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-ui-kit.git"
  },
  "exports": {
    "./kit.css": "./dist/kit.css",
    "./kit.js": "./dist/kit.js",
    "./ai.css": "./dist/ai.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "mp-ui-kit-copy": "scripts/copy-assets.js"
  },
  "files": [
    "dist",
    "scripts/copy-assets.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "test": "node --test test/*.test.js"
  }
}
